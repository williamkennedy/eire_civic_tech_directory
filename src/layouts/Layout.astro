---
import '../styles/global.css';
import { getCategories } from '../lib/categories';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  schema?: object;
}

const {
  title = 'Citizen Data',
  description = 'A curated directory of Irish civic tech tools, platforms, and initiatives that empower citizens and strengthen democratic participation across Ireland.',
  canonical,
  ogType = 'website',
  schema,
} = Astro.props;

const fullTitle = title === 'Citizen Data' ? title : `${title} — Citizen Data`;
const canonicalURL = new URL(canonical || Astro.url.pathname, Astro.site);

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Citizen Data",
  "url": "https://citizendata.ie",
  "description": description,
  "author": {
    "@type": "Person",
    "name": "William Kennedy",
    "url": "https://williamkennedy.ninja"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Helmet Head",
    "url": "https://helmethead.ie"
  }
};

const pageSchema = schema || defaultSchema;

const categories = await getCategories();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Citizen Data" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
<script src="https://cdn.usefathom.com/script.js" data-site="BQCDKGVD" defer></script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="bg-irish-green text-white shadow-lg">
      <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-md group-hover:shadow-lg transition-shadow">
            <span class="text-irish-green font-extrabold text-lg">É</span>
          </div>
          <span class="font-bold text-xl tracking-tight">Citizen Data</span>
        </a>

        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg hover:bg-white/10 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <nav class="hidden md:flex items-center gap-1">
          <a href="/" class="px-4 py-2 rounded-lg font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">Home</a>
          <a href="/about" class="px-4 py-2 rounded-lg font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">About</a>
          <a href="/timeline" class="px-4 py-2 rounded-lg font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">Timeline</a>
          <a href="https://github.com/williamkennedy/eire_civic_tech_directory" class="px-4 py-2 rounded-lg font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">Submit</a>
        </nav>
      </div>

      <nav id="mobile-menu" class="hidden md:hidden px-6 pb-4 space-y-1">
        <a href="/" class="block px-4 py-2 rounded-lg font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">Home</a>
        <a href="/about" class="block px-4 py-2 rounded-lg font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">About</a>
        <a href="/timeline" class="block px-4 py-2 rounded-lg font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">Timeline</a>
        <a href="https://github.com/williamkennedy/eire_civic_tech_directory" class="block px-4 py-2 rounded-lg font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">Submit</a>
      </nav>
    </header>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const isOpen = !menu.classList.contains('hidden');
          menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!isOpen));
        });
      }
    </script>
    <slot />
    <footer class="bg-irish-charcoal text-white/70 mt-16">
      <div class="max-w-6xl mx-auto px-6 py-12 grid gap-10 md:grid-cols-12 text-sm">
        <div class="md:col-span-4">
          <a href="/" class="font-bold text-lg text-white tracking-tight">Citizen Data</a>
          <p class="mt-3 leading-relaxed max-w-xs">
            A curated directory of Irish civic tech tools, platforms and initiatives.
          </p>
        </div>

        <nav aria-label="Site" class="md:col-span-2">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-white mb-4">Explore</h2>
          <ul class="space-y-2">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
            <li><a href="/timeline" class="hover:text-white transition-colors">Timeline</a></li>
            <li><a href="https://github.com/williamkennedy/eire_civic_tech_directory" class="hover:text-white transition-colors">Submit a project</a></li>
          </ul>
        </nav>

        <nav aria-label="Categories" class="md:col-span-6">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-white mb-4">Categories</h2>
          <ul class="columns-2 sm:columns-3 gap-6 space-y-2">
            {categories.map((category) => (
              <li class="break-inside-avoid">
                <a href={`/category/${category.slug}`} class="hover:text-white transition-colors">
                  {category.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="border-t border-white/10">
        <p class="max-w-6xl mx-auto px-6 py-6 text-xs text-white/60">
          Originally created by
          <a
            href="https://williamkennedy.ninja"
            target="_blank"
            rel="noopener noreferrer author me"
            title="William Kennedy — Software engineer and civic tech advocate"
            class="text-white/90 hover:text-white underline underline-offset-2 transition-colors"
          >
            William Kennedy
          </a>
          of
          <a
            href="https://helmethead.ie"
            target="_blank"
            rel="noopener noreferrer"
            title="Helmet Head — Irish software consultancy"
            class="text-white/90 hover:text-white underline underline-offset-2 transition-colors"
          >
            Helmet Head</a>, now maintained by a
          <a
            href="https://github.com/williamkennedy/eire_civic_tech_directory/graphs/contributors"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/90 hover:text-white underline underline-offset-2 transition-colors"
          >
            team of volunteers</a>.
        </p>
      </div>
    </footer>
  </body>
</html>


